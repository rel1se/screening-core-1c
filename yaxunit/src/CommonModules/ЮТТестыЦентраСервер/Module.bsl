Процедура ПовторСообщенияСохраняетID() Экспорт
    Хэш = ИнтеграцияСЭлементомСервер.ВычислитьХэшПолезнойНагрузки("{}");
    Ссылка = ИнтеграцияСЭлементомСервер.СоздатьИсходящееСообщение(Перечисления.ТипыСообщенийОбмена.ПубликацияВерсииТеста, Новый УникальныйИдентификатор, "{}", Хэш);
    Объект = Ссылка.ПолучитьОбъект();
    ID = Объект.ИдентификаторСообщения;
    Объект.Статус = Перечисления.СтатусыСообщенийОбмена.НеобрабатываемаяОшибка;
    Объект.Записать();
    РабочееМестоТестированияСервер.ПовторитьСообщение(Ссылка);
    ЮТест.ОжидаетЧто(Ссылка.ИдентификаторСообщения).Равно(ID);
    ЮТест.ОжидаетЧто(Ссылка.ХэшПолезнойНагрузки).Равно(Хэш);
    ЮТест.ОжидаетЧто(Ссылка.Статус).Равно(Перечисления.СтатусыСообщенийОбмена.Новое);
КонецПроцедуры

Процедура ИдемпотентностьСообщения() Экспорт
    ID = Новый УникальныйИдентификатор;
    ИнтеграцияСЭлементомСервер.ЗафиксироватьОбработанноеВходящееСообщение(ID, "hash", Перечисления.ТипыСообщенийОбмена.РезультатПопытки, Документы.РезультатПопытки.ПустаяСсылка());
    Повтор = ИнтеграцияСЭлементомСервер.ПроверитьПовторноеВходящееСообщение(ID, "hash");
    ЮТест.ОжидаетЧто(Повтор.Найдено И Повтор.СовпадаетХэш).Равно(Истина);
    Коллизия = ИнтеграцияСЭлементомСервер.ПроверитьПовторноеВходящееСообщение(ID, "different");
    ЮТест.ОжидаетЧто(Коллизия.Найдено И Не Коллизия.СовпадаетХэш).Равно(Истина);
КонецПроцедуры

Функция СоздатьКонтрольныйТест() Экспорт
    Тест = РабочееМестоТестированияСервер.СоздатьТест("ЮТ контрольный");
    Версия = Тест.РабочаяВерсия;
    Вопрос = Справочники.ВопросыВерсийТестов.СоздатьЭлемент();
    Вопрос.Владелец = Версия;
    Вопрос.ПорядокВВерсии = 1;
    Вопрос.Наименование = "Вопрос";
    Вопрос.ТекстВопроса = "Выберите верный ответ";
    Вопрос.ТипОтвета = Перечисления.ТипыОтветов.ОдинПравильныйОтвет;
    Вопрос.СпособПроверки = Перечисления.СпособыПроверкиОтвета.ТочныйВариант;
    Вопрос.МаксимальныйБалл = 2;
    Вопрос.Записать();
    Для Номер = 1 По 2 Цикл
        Вариант = Справочники.ВариантыОтветовВерсий.СоздатьЭлемент();
        Вариант.Владелец = Вопрос.Ссылка;
        Вариант.Порядок = Номер;
        Вариант.Наименование = "Вариант " + Строка(Номер);
        Вариант.ТекстВарианта = Вариант.Наименование;
        Вариант.Правильный = Номер = 1;
        Вариант.Записать();
    КонецЦикла;
    Возврат Новый Структура("Тест,Версия,Вопрос", Тест, Версия, Вопрос.Ссылка);
КонецФункции
