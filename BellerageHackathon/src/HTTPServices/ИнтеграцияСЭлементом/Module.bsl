Функция ЗагрузитьРезультат(Запрос) Экспорт

	ИдентификаторСообщенияСтрокой =
		ПолучитьЗаголовок(Запрос, "X-Message-Id");
	ИдентификаторСущностиСтрокой =
		ПолучитьЗаголовок(Запрос, "X-Entity-Id");
	ХэшПолезнойНагрузки =
		ПолучитьЗаголовок(Запрос, "X-Payload-Hash");
	ВерсияКонтракта =
		ПолучитьЗаголовок(Запрос, "X-Contract-Version");

	Если ПустаяСтрока(ВерсияКонтракта) Тогда
		ВерсияКонтракта = "1.0";
	КонецЕсли;

	НастройкиИнтеграции =
		ИнтеграцияСЭлементомСервер.ПолучитьНастройкиОбмена();
	ОжидаемыйТокен = НастройкиИнтеграции.Токен;
	Если Не ПустаяСтрока(ОжидаемыйТокен)
		И ПолучитьЗаголовок(Запрос, "Authorization")
			<> "Bearer " + ОжидаемыйТокен Тогда
		Возврат СформироватьОтвет(
			401,
			"unauthorized",
			"Не передан или неверен Bearer-токен интеграции.");
	КонецЕсли;

	Если ПустаяСтрока(ИдентификаторСообщенияСтрокой)
		Или ПустаяСтрока(ИдентификаторСущностиСтрокой)
		Или ПустаяСтрока(ХэшПолезнойНагрузки) Тогда
		Возврат СформироватьОтвет(
			400,
			"invalid_request",
			"Обязательны заголовки X-Message-Id, X-Entity-Id и X-Payload-Hash.");
	КонецЕсли;

	Попытка
		ИдентификаторСообщения =
			Новый УникальныйИдентификатор(ИдентификаторСообщенияСтрокой);
		ИдентификаторСущности =
			Новый УникальныйИдентификатор(ИдентификаторСущностиСтрокой);
	Исключение
		Возврат СформироватьОтвет(
			400,
			"invalid_identifier",
			"Заголовки идентификаторов должны содержать UUID.");
	КонецПопытки;

	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(ТелоЗапроса) Тогда
		Возврат СформироватьОтвет(400, "empty_body", "Тело запроса не заполнено.");
	КонецЕсли;

	РасчетныйХэш =
		ИнтеграцияСЭлементомСервер.ВычислитьХэшПолезнойНагрузки(
			ТелоЗапроса);
	Если РасчетныйХэш <> ХэшПолезнойНагрузки Тогда
		Возврат СформироватьОтвет(
			400,
			"hash_mismatch",
			"X-Payload-Hash не соответствует SHA-256 тела запроса в Base64.");
	КонецЕсли;

	Попытка
		Обработанное =
			ИнтеграцияСЭлементомСервер.ПроверитьПовторноеВходящееСообщение(
				ИдентификаторСообщения,
				ХэшПолезнойНагрузки);

		Если Обработанное.Найдено Тогда
			Если Обработанное.СовпадаетХэш Тогда
				Возврат СформироватьОтвет(
					200,
					"already_processed",
					Строка(ИдентификаторСообщения));
			Иначе
				Возврат СформироватьОтвет(
					409,
					"message_id_collision",
					"Сообщение с таким messageId уже обработано с другим хэшем.");
			КонецЕсли;
		КонецЕсли;

		СообщениеВОчериди =
			ИнтеграцияСЭлементомСервер.НайтиСообщениеОбмена(
				ИдентификаторСообщения);

		Если СообщениеВОчериди.Найдено Тогда
			Если СообщениеВОчериди.ХэшПолезнойНагрузки = ХэшПолезнойНагрузки Тогда
				Возврат СформироватьОтвет(
					202,
					"already_accepted",
					Строка(ИдентификаторСообщения));
			Иначе
				Возврат СформироватьОтвет(
					409,
					"message_id_collision",
					"Сообщение с таким messageId находится в очереди с другим хэшем.");
			КонецЕсли;
		КонецЕсли;

		ИнтеграцияСЭлементомСервер.СоздатьВходящееСообщение(
			ИдентификаторСообщения,
			Перечисления.ТипыСообщенийОбмена.РезультатПопытки,
			ИдентификаторСущности,
			ТелоЗапроса,
			ХэшПолезнойНагрузки,
			ВерсияКонтракта);

		Возврат СформироватьОтвет(
			202,
			"accepted",
			Строка(ИдентификаторСообщения));

	Исключение
		Возврат СформироватьОтвет(
			500,
			"internal_error",
			ОписаниеОшибки());
	КонецПопытки;

КонецФункции

Функция ПолучитьЗаголовок(Запрос, ИмяЗаголовка)

	Значение = Запрос.Заголовки.Получить(ИмяЗаголовка);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция СформироватьОтвет(КодСостояния, Статус, Сообщение)

	ДанныеОтвета = Новый Структура;
	ДанныеОтвета.Вставить("status", Статус);
	ДанныеОтвета.Вставить("message", Сообщение);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ДанныеОтвета);
	ТелоОтвета = Запись.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить(
		"Content-Type",
		"application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(
		ТелоОтвета,
		КодировкаТекста.UTF8);

	Возврат Ответ;

КонецФункции
