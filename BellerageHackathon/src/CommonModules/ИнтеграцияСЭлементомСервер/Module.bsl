#Область ПрограммныйИнтерфейс

Перем КэшТокенаДоступаЭлемента;
Перем ДействуетДоКэшТокенаЭлемента;

Функция СоздатьИсходящееСообщение(
	ТипСообщения,
	ИдентификаторСущности,
	ПолезнаяНагрузка,
	ХэшПолезнойНагрузки,
	ИдентификаторКорреляции = Неопределено,
	ВерсияКонтракта = "1.0") Экспорт

	Если Не ЗначениеЗаполнено(ТипСообщения) Тогда
		ВызватьИсключение "Не указан тип исходящего сообщения.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторСущности) Тогда
		ВызватьИсключение "Не указан идентификатор сущности.";
	КонецЕсли;

	Если ПустаяСтрока(ХэшПолезнойНагрузки) Тогда
		ВызватьИсключение "Не указан хэш полезной нагрузки.";
	КонецЕсли;

	ИдентификаторСообщения = Новый УникальныйИдентификатор;
	Если ИдентификаторКорреляции = Неопределено Тогда
		ИдентификаторКорреляции = ИдентификаторСообщения;
	КонецЕсли;

	Сообщение = Справочники.СообщенияОбмена.СоздатьЭлемент();
	Сообщение.Наименование = СтрШаблон("%1, %2", ТипСообщения, ИдентификаторСообщения);
	Сообщение.ИдентификаторСообщения = ИдентификаторСообщения;
	Сообщение.Направление = Перечисления.НаправленияОбмена.Исходящее;
	Сообщение.ТипСообщения = ТипСообщения;
	Сообщение.Статус = Перечисления.СтатусыСообщенийОбмена.Новое;
	Сообщение.ИдентификаторКорреляции = ИдентификаторКорреляции;
	Сообщение.ИдентификаторСущности = ИдентификаторСущности;
	Сообщение.ВерсияКонтракта = ВерсияКонтракта;
	Сообщение.ДатаСоздания = ТекущаяДатаСеанса();
	Сообщение.ДатаСледующейПопытки = ТекущаяДатаСеанса();
	Сообщение.КоличествоПопыток = 0;
	Сообщение.ХэшПолезнойНагрузки = ХэшПолезнойНагрузки;
	Сообщение.ПолезнаяНагрузка = Новый ХранилищеЗначения(ПолезнаяНагрузка);
	Сообщение.Записать();

	Возврат Сообщение.Ссылка;

КонецФункции

Функция ПроверитьПовторноеВходящееСообщение(
	ИдентификаторСообщения,
	ХэшСообщения) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обработанные.ХэшСообщения КАК ХэшСообщения,
	|	Обработанные.РезультатПопытки КАК РезультатПопытки
	|ИЗ
	|	РегистрСведений.ОбработанныеВходящиеСообщения КАК Обработанные
	|ГДЕ
	|	Обработанные.ИдентификаторСообщения = &ИдентификаторСообщения";

	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Структура(
		"Найдено, СовпадаетХэш, РезультатПопытки",
		Ложь,
		Ложь,
		Документы.РезультатПопытки.ПустаяСсылка());

	Если Выборка.Следующий() Тогда
		Результат.Найдено = Истина;
		Результат.СовпадаетХэш = Выборка.ХэшСообщения = ХэшСообщения;
		Результат.РезультатПопытки = Выборка.РезультатПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ЗафиксироватьОбработанноеВходящееСообщение(
	ИдентификаторСообщения,
	ХэшСообщения,
	ТипСообщения,
	РезультатПопытки = Неопределено) Экспорт

	Повтор = ПроверитьПовторноеВходящееСообщение(
		ИдентификаторСообщения,
		ХэшСообщения);

	Если Повтор.Найдено Тогда
		Если Не Повтор.СовпадаетХэш Тогда
			ВызватьИсключение "Коллизия messageId: сообщение уже обработано с другим хэшем.";
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ЗафиксироватьОбработанноеВходящееСообщениеБезПроверки(
		ИдентификаторСообщения,
		ХэшСообщения,
		ТипСообщения,
		РезультатПопытки);

КонецПроцедуры

Процедура ЗафиксироватьОбработанноеВходящееСообщениеБезПроверки(
	ИдентификаторСообщения,
	ХэшСообщения,
	ТипСообщения,
	РезультатПопытки = Неопределено)

	Если РезультатПопытки = Неопределено Тогда
		РезультатПопытки = Документы.РезультатПопытки.ПустаяСсылка();
	КонецЕсли;

	Запись = РегистрыСведений.ОбработанныеВходящиеСообщения.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.ХэшСообщения = ХэшСообщения;
	Запись.ТипСообщения = ТипСообщения;
	Запись.ДатаОбработки = ТекущаяДатаСеанса();
	Запись.РезультатПопытки = РезультатПопытки;
	Запись.Записать();

КонецПроцедуры

Процедура ЗарегистрироватьИдентификаторИнтеграции(
	ВидСущности,
	Идентификатор,
	Объект1С) Экспорт

	Если ПустаяСтрока(СокрЛП(ВидСущности)) Тогда
		ВызватьИсключение "Не указан вид интеграционной сущности.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Идентификатор)
		Или Не ЗначениеЗаполнено(Объект1С) Тогда
		ВызватьИсключение "Не заполнено соответствие интеграционных идентификаторов.";
	КонецЕсли;

	Запись = РегистрыСведений.ИдентификаторыИнтеграции.СоздатьМенеджерЗаписи();
	Запись.ВидСущности = ВидСущности;
	Запись.Идентификатор = Идентификатор;
	Запись.Объект1С = Объект1С;
	Запись.ДатаРегистрации = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

Функция НайтиОбъект1С(ВидСущности, Идентификатор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Идентификаторы.Объект1С КАК Объект1С
	|ИЗ
	|	РегистрСведений.ИдентификаторыИнтеграции КАК Идентификаторы
	|ГДЕ
	|	Идентификаторы.ВидСущности = &ВидСущности
	|	И Идентификаторы.Идентификатор = &Идентификатор";

	Запрос.УстановитьПараметр("ВидСущности", ВидСущности);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Объект1С;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура ОбновитьСостояниеСинхронизацииВерсии(
	ВерсияТеста,
	ИдентификаторСообщения,
	ХэшСодержимого,
	Статус,
	КоличествоПопыток = 0,
