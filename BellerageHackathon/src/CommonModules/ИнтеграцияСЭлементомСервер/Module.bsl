	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.ХэшСодержимого = ХэшСодержимого;
	Запись.Статус = Статус;
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.КоличествоПопыток = КоличествоПопыток;
	Запись.ТекстОшибки = ТекстОшибки;
	Запись.Записать();

КонецПроцедуры

Функция ПолучитьСообщенияКОтправке(ДатаДо, МаксимальноеКоличество = 100) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ &МаксимальноеКоличество
	|	Сообщения.Ссылка КАК Сообщение
	|ИЗ
	|	Справочник.СообщенияОбмена КАК Сообщения
	|ГДЕ
	|	Сообщения.Направление = ЗНАЧЕНИЕ(Перечисление.НаправленияОбмена.Исходящее)
	|	И Сообщения.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыСообщенийОбмена.Новое),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыСообщенийОбмена.ОжидаетПовтора))
	|	И Сообщения.ДатаСледующейПопытки <= &ДатаДо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сообщения.ДатаСледующейПопытки,
	|	Сообщения.ДатаСоздания";

	Запрос.УстановитьПараметр("МаксимальноеКоличество", МаксимальноеКоличество);
	Запрос.УстановитьПараметр("ДатаДо", ДатаДо);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Сообщение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НайтиСообщениеОбмена(ИдентификаторСообщения) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сообщения.Ссылка КАК Сообщение,
	|	Сообщения.ХэшПолезнойНагрузки КАК ХэшПолезнойНагрузки,
	|	Сообщения.Статус КАК Статус
	|ИЗ
	|	Справочник.СообщенияОбмена КАК Сообщения
	|ГДЕ
	|	Сообщения.ИдентификаторСообщения = &ИдентификаторСообщения";

	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Структура(
		"Найдено, Сообщение, ХэшПолезнойНагрузки, Статус",
		Ложь,
		Справочники.СообщенияОбмена.ПустаяСсылка(),
		"",
		Перечисления.СтатусыСообщенийОбмена.Новое);

	Если Выборка.Следующий() Тогда
		Результат.Найдено = Истина;
		Результат.Сообщение = Выборка.Сообщение;
		Результат.ХэшПолезнойНагрузки = Выборка.ХэшПолезнойНагрузки;
		Результат.Статус = Выборка.Статус;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СоздатьВходящееСообщение(
	ИдентификаторСообщения,
	ТипСообщения,
	ИдентификаторСущности,
	ПолезнаяНагрузка,
	ХэшПолезнойНагрузки,
	ВерсияКонтракта = "1.0") Экспорт

	НайденноеСообщение = НайтиСообщениеОбмена(ИдентификаторСообщения);
	Если НайденноеСообщение.Найдено Тогда
		Если НайденноеСообщение.ХэшПолезнойНагрузки <> ХэшПолезнойНагрузки Тогда
			ВызватьИсключение "Коллизия messageId: в очереди уже есть сообщение с другим хэшем.";
		КонецЕсли;
		Возврат НайденноеСообщение.Сообщение;
	КонецЕсли;

	Сообщение = Справочники.СообщенияОбмена.СоздатьЭлемент();
	Сообщение.ИдентификаторСообщения = ИдентификаторСообщения;
	Сообщение.Наименование = СтрШаблон("%1, %2", ТипСообщения, ИдентификаторСообщения);
	Сообщение.Направление = Перечисления.НаправленияОбмена.Входящее;
	Сообщение.ТипСообщения = ТипСообщения;
	Сообщение.Статус = Перечисления.СтатусыСообщенийОбмена.Новое;
	Сообщение.ИдентификаторКорреляции = ИдентификаторСообщения;
	Сообщение.ИдентификаторСущности = ИдентификаторСущности;
	Сообщение.ВерсияКонтракта = ВерсияКонтракта;
	Сообщение.ДатаСоздания = ТекущаяДатаСеанса();
	Сообщение.ДатаСледующейПопытки = ТекущаяДатаСеанса();
	Сообщение.ХэшПолезнойНагрузки = ХэшПолезнойНагрузки;
	Сообщение.ПолезнаяНагрузка = Новый ХранилищеЗначения(ПолезнаяНагрузка);
	Сообщение.Записать();

	Возврат Сообщение.Ссылка;

КонецФункции

Функция ПолучитьНастройкиОбмена() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Хост", Константы.ХостAPIЭлемента.Получить());
	Настройки.Вставить("Порт", Константы.ПортAPIЭлемента.Получить());
	Настройки.Вставить("ИспользоватьHTTPS", Константы.ИспользоватьHTTPSЭлемента.Получить());
	Настройки.Вставить("БазовыйПуть", Константы.БазовыйПутьAPIЭлемента.Получить());
	Настройки.Вставить("ПутьПолученияТокена", Константы.ПутьПолученияТокенаЭлемента.Получить());
	Настройки.Вставить("ИдентификаторКлиента", Константы.ИдентификаторКлиентаЭлемента.Получить());
	Настройки.Вставить("СекретКлиента", Константы.СекретКлиентаЭлемента.Получить());
	Настройки.Вставить("Таймаут", Константы.ТаймаутHTTPСекунды.Получить());
	Настройки.Вставить("МаксимумПопыток", Константы.МаксимумПопытокОбмена.Получить());
	Настройки.Вставить("БазоваяЗадержка", Константы.БазоваяЗадержкаПовтораСекунды.Получить());
	Настройки.Вставить("РазмерПакета", Константы.РазмерПакетаОбмена.Получить());

	Если Настройки.Порт = 0 Тогда
		Если Настройки.ИспользоватьHTTPS Тогда
			Настройки.Порт = 443;
		Иначе
			Настройки.Порт = 80;
		КонецЕсли;
	КонецЕсли;

	Если Настройки.Таймаут = 0 Тогда
		Настройки.Таймаут = 30;
	КонецЕсли;
	Если Настройки.МаксимумПопыток = 0 Тогда
		Настройки.МаксимумПопыток = 10;
	КонецЕсли;
	Если Настройки.БазоваяЗадержка = 0 Тогда
		Настройки.БазоваяЗадержка = 60;
	КонецЕсли;
	Если Настройки.РазмерПакета = 0 Тогда
		Настройки.РазмерПакета = 100;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Настройки.ПутьПолученияТокена)) Тогда
		Настройки.ПутьПолученияТокена = "/auth/oidc/token";
	КонецЕсли;

	Возврат Настройки;

КонецФункции

Функция ПолучитьТокенДоступаЭлемента(Настройки, ПринудительноОбновить = Ложь) Экспорт

	Если Не АвторизацияНастроена(Настройки) Тогда
		Возврат "";
	КонецЕсли;

	ТекущаяДата = ТекущаяДатаСеанса();
	Если Не ПринудительноОбновить
		И ТипЗнч(КэшТокенаДоступаЭлемента) = Тип("Строка")
		И Не ПустаяСтрока(КэшТокенаДоступаЭлемента)
		И ТипЗнч(ДействуетДоКэшТокенаЭлемента) = Тип("Дата")
		И ДействуетДоКэшТокенаЭлемента > ТекущаяДата Тогда
		Возврат КэшТокенаДоступаЭлемента;
	КонецЕсли;

	Соединение = СоздатьHTTPСоединениеЭлемента(Настройки);
	Запрос = Новый HTTPЗапрос(НормализоватьHTTPПуть(Настройки.ПутьПолученияТокена));
	Запрос.Заголовки.Вставить("Accept", "application/json");
	Запрос.Заголовки.Вставить("Client-Id", Настройки.ИдентификаторКлиента);
	Запрос.Заголовки.Вставить("Client-Secret", Настройки.СекретКлиента);

	Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон(
			"Сервис авторизации Элемента вернул HTTP %1.",
			Ответ.КодСостояния);
	КонецЕсли;

	ДанныеТокена = РазобратьОтветТокенаЭлемента(Ответ.ПолучитьТелоКакСтроку());
	КэшТокенаДоступаЭлемента = ДанныеТокена.Токен;
	ЗапасСекунд = 60;
	Если ДанныеТокена.СрокДействияСекунд <= 120 Тогда
		ЗапасСекунд = 5;
	КонецЕсли;
	СрокКэширования = ДанныеТокена.СрокДействияСекунд - ЗапасСекунд;
	Если СрокКэширования < 1 Тогда
		СрокКэширования = 1;
	КонецЕсли;
	ДействуетДоКэшТокенаЭлемента = ТекущаяДата + СрокКэширования;

	Возврат КэшТокенаДоступаЭлемента;

КонецФункции

Функция РазобратьОтветТокенаЭлемента(ТелоОтвета) Экспорт

	Если ПустаяСтрока(СокрЛП(Строка(ТелоОтвета))) Тогда
		ВызватьИсключение "Сервис авторизации Элемента вернул пустой ответ.";
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(Строка(ТелоОтвета));
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		ВызватьИсключение "Ответ сервиса авторизации Элемента не является корректным JSON.";
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение "Ответ сервиса авторизации Элемента должен быть объектом JSON.";
	КонецЕсли;

	Токен = Неопределено;
	Если Не Данные.Свойство("access_token", Токен)
		И Не Данные.Свойство("accessToken", Токен)
		И Не Данные.Свойство("token", Токен) Тогда
		ВызватьИсключение "Ответ сервиса авторизации Элемента не содержит access token.";
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Строка(Токен))) Тогда
		ВызватьИсключение "Сервис авторизации Элемента вернул пустой access token.";
	КонецЕсли;

	СрокДействия = 300;
	ЗначениеСрока = Неопределено;
	Если Данные.Свойство("expires_in", ЗначениеСрока)
		Или Данные.Свойство("expiresIn", ЗначениеСрока) Тогда
		Попытка
			СрокДействия = Число(ЗначениеСрока);
		Исключение
			ВызватьИсключение "Поле срока действия токена должно содержать число секунд.";
		КонецПопытки;
	КонецЕсли;
	Если СрокДействия < 1 Тогда
		ВызватьИсключение "Срок действия токена должен быть положительным.";
	КонецЕсли;

	Возврат Новый Структура(
		"Токен, СрокДействияСекунд",
		Строка(Токен),
		СрокДействия);

КонецФункции

Процедура СброситьКэшТокенаДоступаЭлемента() Экспорт

	КэшТокенаДоступаЭлемента = Неопределено;
	ДействуетДоКэшТокенаЭлемента = Неопределено;

КонецПроцедуры

Функция ПроверитьАвторизациюЭлемента() Экспорт

	Настройки = ПолучитьНастройкиОбмена();
	СброситьКэшТокенаДоступаЭлемента();
	Токен = ПолучитьТокенДоступаЭлемента(Настройки, Истина);
	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Не заполнены Client-Id и Client-Secret приложения Элемента.";
	КонецЕсли;
	Возврат Новый Структура(
		"Успешно, ДействуетДо",
		Не ПустаяСтрока(Токен),
		ДействуетДоКэшТокенаЭлемента);

КонецФункции

Функция АвторизацияНастроена(Настройки)

	ЕстьИдентификатор = Не ПустаяСтрока(СокрЛП(Строка(Настройки.ИдентификаторКлиента)));
	ЕстьСекрет = Не ПустаяСтрока(СокрЛП(Строка(Настройки.СекретКлиента)));
	Если ЕстьИдентификатор <> ЕстьСекрет Тогда
		ВызватьИсключение "Для авторизации Элемента необходимо заполнить одновременно Client-Id и Client-Secret.";
	КонецЕсли;

	Возврат ЕстьИдентификатор И ЕстьСекрет;

КонецФункции

Функция СоздатьHTTPСоединениеЭлемента(Настройки)

	ЗащищенноеСоединение = Неопределено;
	Если Настройки.ИспользоватьHTTPS Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;

	Возврат Новый HTTPСоединение(
		Настройки.Хост,
		Настройки.Порт,
		,
		,
		,
		Настройки.Таймаут,
		ЗащищенноеСоединение);

КонецФункции

Функция НормализоватьHTTPПуть(Путь)

	Путь = СокрЛП(Строка(Путь));
	Если ПустаяСтрока(Путь) Тогда
		Возврат "/";
	КонецЕсли;
	Если Лев(Путь, 1) <> "/" Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	Возврат Путь;

КонецФункции

Процедура ОбработатьОчередьИсходящихСообщений() Экспорт

	Настройки = ПолучитьНастройкиОбмена();
	Если ПустаяСтрока(СокрЛП(Настройки.Хост)) Тогда
		ВызватьИсключение "Не настроен хост API 1С:Элемента.";
	КонецЕсли;

	СообщенияКОтправке = ПолучитьСообщенияКОтправке(
		ТекущаяДатаСеанса(),
		Настройки.РазмерПакета);

	Для Каждого Сообщение Из СообщенияКОтправке Цикл
		ОтправитьИсходящееСообщение(Сообщение, Настройки);
	КонецЦикла;

КонецПроцедуры

Процедура ОтправитьИсходящееСообщение(Сообщение, Настройки)

	СообщениеОбъект = Сообщение.ПолучитьОбъект();
	СообщениеОбъект.Статус = Перечисления.СтатусыСообщенийОбмена.ВОбработке;
	СообщениеОбъект.ДатаПоследнейПопытки = ТекущаяДатаСеанса();
	СообщениеОбъект.КоличествоПопыток = СообщениеОбъект.КоличествоПопыток + 1;
	СообщениеОбъект.ТекстОшибки = "";
	СообщениеОбъект.Записать();

	Попытка
		Соединение = СоздатьHTTPСоединениеЭлемента(Настройки);
		ТокенДоступа = ПолучитьТокенДоступаЭлемента(Настройки);

		Путь = СоединитьПути(
			Настройки.БазовыйПуть,
			ПолучитьПутьДляТипаСообщения(СообщениеОбъект.ТипСообщения));

		Запрос = Новый HTTPЗапрос(Путь);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.Заголовки.Вставить(
			"X-Message-Id",
			Строка(СообщениеОбъект.ИдентификаторСообщения));
		Запрос.Заголовки.Вставить(
			"X-Entity-Id",
			Строка(СообщениеОбъект.ИдентификаторСущности));
		Запрос.Заголовки.Вставить(
			"X-Payload-Hash",
			СообщениеОбъект.ХэшПолезнойНагрузки);
		Запрос.Заголовки.Вставить(
			"X-Contract-Version",
			СообщениеОбъект.ВерсияКонтракта);

		Если Не ПустаяСтрока(ТокенДоступа) Тогда
			Запрос.Заголовки.Вставить(
				"Authorization",
				"Bearer " + ТокенДоступа);
		КонецЕсли;

		ТелоСообщения = СообщениеОбъект.ПолезнаяНагрузка.Получить();
		Запрос.УстановитьТелоИзСтроки(
			Строка(ТелоСообщения),
			КодировкаТекста.UTF8);

		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		Если Ответ.КодСостояния = 401 И Не ПустаяСтрока(ТокенДоступа) Тогда
			ТокенДоступа = ПолучитьТокенДоступаЭлемента(Настройки, Истина);
			Запрос.Заголовки.Вставить("Authorization", "Bearer " + ТокенДоступа);
			Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		КонецЕсли;
		СообщениеОбъект.КодHTTP = Ответ.КодСостояния;

		Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
			СообщениеОбъект.Статус = Перечисления.СтатусыСообщенийОбмена.Отправлено;
			СообщениеОбъект.ДатаОбработки = ТекущаяДатаСеанса();
			СообщениеОбъект.ТекстОшибки = "";
		Иначе
			ЗафиксироватьОшибкуОтправки(
				СообщениеОбъект,
				Настройки,
				СтрШаблон(
					"HTTP %1: %2",
					Ответ.КодСостояния,
					Ответ.ПолучитьТелоКакСтроку()));
		КонецЕсли;

	Исключение
		ЗафиксироватьОшибкуОтправки(
			СообщениеОбъект,
			Настройки,
			ОписаниеОшибки());
	КонецПопытки;

	СообщениеОбъект.Записать();

КонецПроцедуры

Процедура ЗафиксироватьОшибкуОтправки(СообщениеОбъект, Настройки, ТекстОшибки)

	СообщениеОбъект.ТекстОшибки = Лев(ТекстОшибки, 4000);

	Если СообщениеОбъект.КоличествоПопыток >= Настройки.МаксимумПопыток Тогда
		СообщениеОбъект.Статус =
			Перечисления.СтатусыСообщенийОбмена.НеобрабатываемаяОшибка;
	Иначе
		СообщениеОбъект.Статус =
			Перечисления.СтатусыСообщенийОбмена.ОжидаетПовтора;
		Задержка = Настройки.БазоваяЗадержка
			* СообщениеОбъект.КоличествоПопыток;
		СообщениеОбъект.ДатаСледующейПопытки =
			ТекущаяДатаСеанса() + Задержка;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПутьДляТипаСообщения(ТипСообщения)

	Если ТипСообщения = Перечисления.ТипыСообщенийОбмена.ПубликацияВерсииТеста Тогда
		Возврат "/test-versions";
	ИначеЕсли ТипСообщения = Перечисления.ТипыСообщенийОбмена.АрхивацияТеста Тогда
		Возврат "/test-archives";
	ИначеЕсли ТипСообщения = Перечисления.ТипыСообщенийОбмена.Подтверждение Тогда
		Возврат "/confirmations";
	ИначеЕсли ТипСообщения
		= Перечисления.ТипыСообщенийОбмена.РезультатРучнойПроверки Тогда
		Возврат "/manual-review-results";
	КонецЕсли;

	ВызватьИсключение "Для типа сообщения не настроен endpoint 1С:Элемента.";

КонецФункции

Функция СоединитьПути(БазовыйПуть, ОтносительныйПуть)

	БазовыйПуть = СокрЛП(БазовыйПуть);
	Если ПустаяСтрока(БазовыйПуть) Тогда
		Возврат ОтносительныйПуть;
	КонецЕсли;

	Если Прав(БазовыйПуть, 1) = "/" Тогда
		БазовыйПуть = Лев(БазовыйПуть, СтрДлина(БазовыйПуть) - 1);
	КонецЕсли;

	Если Лев(ОтносительныйПуть, 1) <> "/" Тогда
		ОтносительныйПуть = "/" + ОтносительныйПуть;
	КонецЕсли;

	Возврат БазовыйПуть + ОтносительныйПуть;

КонецФункции

Процедура ОбработатьОчередьВходящихСообщений() Экспорт

	Настройки = ПолучитьНастройкиОбмена();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ &РазмерПакета
	|	Сообщения.Ссылка КАК Сообщение,
	|	ЕСТЬNULL(Обработанные.ХэшСообщения, """") КАК ХэшОбработанного
	|ИЗ
	|	Справочник.СообщенияОбмена КАК Сообщения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОбработанныеВходящиеСообщения КАК Обработанные
	|		ПО Сообщения.ИдентификаторСообщения = Обработанные.ИдентификаторСообщения
	|ГДЕ
	|	Сообщения.Направление = ЗНАЧЕНИЕ(Перечисление.НаправленияОбмена.Входящее)
	|	И Сообщения.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыСообщенийОбмена.Новое),
	|		ЗНАЧЕНИЕ(Перечисление.СтатусыСообщенийОбмена.ОжидаетПовтора))
	|	И Сообщения.ДатаСледующейПопытки <= &ТекущаяДата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сообщения.ДатаСоздания";

	Запрос.УстановитьПараметр("РазмерПакета", Настройки.РазмерПакета);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбработатьВходящееСообщение(
			Выборка.Сообщение,
			Настройки,
			Выборка.ХэшОбработанного);
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьВходящееСообщение(
	Сообщение,
	Настройки,
	ХэшОбработанного)

	СообщениеОбъект = Сообщение.ПолучитьОбъект();
	СообщениеОбъект.Статус = Перечисления.СтатусыСообщенийОбмена.ВОбработке;
	СообщениеОбъект.ДатаПоследнейПопытки = ТекущаяДатаСеанса();
	СообщениеОбъект.КоличествоПопыток = СообщениеОбъект.КоличествоПопыток + 1;
	СообщениеОбъект.Записать();

	Попытка
		Если Не ПустаяСтрока(ХэшОбработанного) Тогда
			Если ХэшОбработанного <> СообщениеОбъект.ХэшПолезнойНагрузки Тогда
				СообщениеОбъект.Статус =
					Перечисления.СтатусыСообщенийОбмена.Карантин;
				СообщениеОбъект.ТекстОшибки =
					"Коллизия messageId: обработанное сообщение имеет другой хэш.";
			Иначе
				СообщениеОбъект.Статус =
					Перечисления.СтатусыСообщенийОбмена.Обработано;
				СообщениеОбъект.ДатаОбработки = ТекущаяДатаСеанса();
			КонецЕсли;
			СообщениеОбъект.Записать();
			Возврат;
		КонецЕсли;

		Если СообщениеОбъект.ТипСообщения
			<> Перечисления.ТипыСообщенийОбмена.РезультатПопытки Тогда
			ВызватьИсключение "Получен неподдерживаемый тип входящего сообщения.";
		КонецЕсли;

		ТекстJSON = Строка(СообщениеОбъект.ПолезнаяНагрузка.Получить());

		НачатьТранзакцию();
		Попытка
			РезультатПопытки = СоздатьРезультатПопыткиИзJSON(
				ТекстJSON,
				СообщениеОбъект);

			ЗафиксироватьОбработанноеВходящееСообщениеБезПроверки(
				СообщениеОбъект.ИдентификаторСообщения,
				СообщениеОбъект.ХэшПолезнойНагрузки,
				СообщениеОбъект.ТипСообщения,
				РезультатПопытки);

			СообщениеОбъект.Статус =
				Перечисления.СтатусыСообщенийОбмена.Обработано;
			СообщениеОбъект.ДатаОбработки = ТекущаяДатаСеанса();
			СообщениеОбъект.ТекстОшибки = "";
			СообщениеОбъект.Записать();

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

	Исключение
		СообщениеОбъект = Сообщение.ПолучитьОбъект();
		ЗафиксироватьОшибкуОбработкиВходящего(
			СообщениеОбъект,
			Настройки,
			ОписаниеОшибки());
		СообщениеОбъект.Записать();
	КонецПопытки;

КонецПроцедуры

Функция СоздатьРезультатПопыткиИзJSON(ТекстJSON, СообщениеОбъект)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(Чтение);

	ИдентификаторПопытки = ПолучитьUUIDJSON(Данные, "attemptId");
	ИдентификаторНазначения = ПолучитьUUIDJSON(Данные, "assignmentId");
	РевизияРезультата = ПолучитьСвойствоJSON(Данные, "revision");

	ДанныеКандидата = ПолучитьСвойствоJSON(Данные, "candidate");
	ИдентификаторКандидата = ПолучитьUUIDJSON(ДанныеКандидата, "id");
	Кандидат = ПолучитьИлиСоздатьКандидата(ДанныеКандидата, ИдентификаторКандидата);

	ДанныеТеста = ПолучитьСвойствоJSON(Данные, "test");
	ИдентификаторТеста = ПолучитьUUIDJSON(ДанныеТеста, "id");
	ИдентификаторВерсии = ПолучитьUUIDJSON(ДанныеТеста, "versionId");
	Тест = НайтиТестПоИдентификатору(ИдентификаторТеста);
	ВерсияТеста = НайтиВерсиюПоИдентификатору(ИдентификаторВерсии);

	Если Не ЗначениеЗаполнено(Тест)
		Или Не ЗначениеЗаполнено(ВерсияТеста) Тогда
		ВызватьИсключение "Тест или опубликованная версия не найдены в 1С.";
	КонецЕсли;

	Если ВерсияТеста.Владелец <> Тест Тогда
		ВызватьИсключение "Указанная версия принадлежит другому тесту.";
	КонецЕсли;

	Документ = Документы.РезультатПопытки.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.ИдентификаторСообщения = СообщениеОбъект.ИдентификаторСообщения;
	Документ.ИдентификаторПопытки = ИдентификаторПопытки;
	Документ.РевизияРезультата = РевизияРезультата;
	Документ.ИдентификаторНазначения = ИдентификаторНазначения;
	Документ.Кандидат = Кандидат;
	Документ.ИмяКандидатаСнимок =
		ПолучитьСвойствоJSON(ДанныеКандидата, "displayName");
	Документ.Тест = Тест;
	Документ.ВерсияТеста = ВерсияТеста;
	Документ.ХэшВерсииТеста =
		ПолучитьСвойствоJSON(ДанныеТеста, "versionHash");
    Если ВерсияТеста.СтатусВерсии = Перечисления.СтатусыВерсийТестов.Черновик
        Или Документ.ХэшВерсииТеста <> ВерсияТеста.ХэшСодержимого Тогда
        ВызватьИсключение "Результат должен ссылаться на опубликованную версию с совпадающим хэшем.";
    КонецЕсли;
	Документ.ДатаНачала =
		ПолучитьДатуJSON(Данные, "startedAt");
	Документ.ДатаЗавершения =
		ПолучитьДатуJSON(Данные, "finishedAt");
	Документ.ДатаПолучения = ТекущаяДатаСеанса();
	Документ.СпособЗавершения =
		ПолучитьСпособЗавершения(
			ПолучитьСвойствоJSON(Данные, "completionMode"));
	Документ.ПроходнойБаллСнимок = ВерсияТеста.ПроходнойБаллПроцентов;
	Документ.ХэшИсходногоСообщения =
		СообщениеОбъект.ХэшПолезнойНагрузки;
	Документ.ИсходноеСообщение = Новый ХранилищеЗначения(ТекстJSON);

	ОтветыJSON = ПолучитьСвойствоJSON(Данные, "answers");
	Для Каждого ОтветJSON Из ОтветыJSON Цикл
		ЗаполнитьОтветИзJSON(Документ, ОтветJSON, ВерсияТеста);
	КонецЦикла;

    ВопросыВерсии = РабочееМестоТестированияСервер.СписокПодчиненных("ВопросыВерсийТестов", ВерсияТеста);
    Если Документ.Ответы.Количество() <> ВопросыВерсии.Количество() Тогда
        ВызватьИсключение "Результат должен содержать ответы на все вопросы версии, включая пропущенные.";
    КонецЕсли;
    УникальныеВопросы = Новый Соответствие;
    Для Каждого Ответ Из Документ.Ответы Цикл
        Если УникальныеВопросы.Получить(Ответ.ВопросВерсии) <> Неопределено Тогда
            ВызватьИсключение "Вопрос в результате повторяется.";
        КонецЕсли;
        УникальныеВопросы.Вставить(Ответ.ВопросВерсии, Истина);
    КонецЦикла;
	Документ.Записать();

	ЗарегистрироватьИдентификаторИнтеграции(
		"attempt",
		ИдентификаторПопытки,
		Документ.Ссылка);

	Возврат Документ.Ссылка;

КонецФункции

Процедура ЗаполнитьОтветИзJSON(Документ, ОтветJSON, ВерсияТеста)

	ИдентификаторОтвета = ПолучитьUUIDJSON(ОтветJSON, "answerId");
	ИдентификаторВопроса = ПолучитьUUIDJSON(ОтветJSON, "questionVersionId");
	Вопрос = НайтиВопросПоИдентификаторуВерсии(ИдентификаторВопроса);

	Если Не ЗначениеЗаполнено(Вопрос)
		Или Вопрос.Владелец <> ВерсияТеста Тогда
		ВызватьИсключение "Вопрос из результата не найден в опубликованной версии.";
	КонецЕсли;

	СтрокаОтвета = Документ.Ответы.Добавить();
	СтрокаОтвета.ИдентификаторОтвета = ИдентификаторОтвета;
	СтрокаОтвета.ПорядокВПопытке =
		ПолучитьСвойствоJSON(ОтветJSON, "order");
	СтрокаОтвета.ВопросВерсии = Вопрос;
	СтрокаОтвета.ТекстВопросаСнимок = Вопрос.ТекстВопроса;
	СтрокаОтвета.ТипОтветаСнимок = Вопрос.ТипОтвета;
	СтрокаОтвета.ТекстовыйОтвет =
		ПолучитьСвойствоJSON(ОтветJSON, "textAnswer", Ложь, "");
	СтрокаОтвета.ОтветДан =
		ПолучитьСвойствоJSON(ОтветJSON, "answered");
	СтрокаОтвета.СтатусПроверки =
		ПолучитьСтатусПроверкиОтвета(
			ПолучитьСвойствоJSON(ОтветJSON, "checkStatus"));
	СтрокаОтвета.ОтветПравильный =
		ПолучитьСвойствоJSON(ОтветJSON, "isCorrect", Ложь, Ложь);
	СтрокаОтвета.НабраноБаллов =
		ПолучитьСвойствоJSON(ОтветJSON, "awardedPoints");
	СтрокаОтвета.МаксимальныйБалл = Вопрос.МаксимальныйБалл;
	СтрокаОтвета.КомментарийПроверки =
		ПолучитьСвойствоJSON(ОтветJSON, "reviewComment", Ложь, "");

	ВариантыJSON =
		ПолучитьСвойствоJSON(ОтветJSON, "options", Ложь, Новый Массив);
	Для Каждого ВариантJSON Из ВариантыJSON Цикл
		ЗаполнитьВариантИзJSON(
			Документ,
			ВариантJSON,
			ИдентификаторОтвета,
			Вопрос);
	КонецЦикла;

    Выбранные = Новый Массив;
    Правильные = Новый Массив;
    Показанные = Новый Соответствие;
    Для Каждого ВариантJSON Из ВариантыJSON Цикл
        ID = ПолучитьUUIDJSON(ВариантJSON, "optionVersionId");
        Если Показанные.Получить(ID) <> Неопределено Тогда ВызватьИсключение "Вариант ответа повторяется."; КонецЕсли;
        Показанные.Вставить(ID, Истина);
        Если ПолучитьСвойствоJSON(ВариантJSON, "selected") Тогда Выбранные.Добавить(ID); КонецЕсли;
    КонецЦикла;
    ВариантыВерсии = Справочники.ВариантыОтветовВерсий.Выбрать(, Вопрос);
    ЧислоВариантов = 0;
    Пока ВариантыВерсии.Следующий() Цикл
        Если ВариантыВерсии.ПометкаУдаления Тогда Продолжить; КонецЕсли;
        ЧислоВариантов = ЧислоВариантов + 1;
        Если ВариантыВерсии.Правильный Тогда Правильные.Добавить(ВариантыВерсии.ИдентификаторВерсииВарианта); КонецЕсли;
    КонецЦикла;
    Если ЧислоВариантов <> Показанные.Количество() Тогда ВызватьИсключение "Неполный набор показанных вариантов."; КонецЕсли;
    Оценка = РасчетРезультатовТестовСервер.ОценитьОтвет(Вопрос, СтрокаОтвета.ТекстовыйОтвет, Выбранные, Правильные);
    ЗаполнитьЗначенияСвойств(СтрокаОтвета, Оценка);
    СтрокаОтвета.ОтветДан = Выбранные.Количество() > 0 Или Не ПустаяСтрока(СокрЛП(СтрокаОтвета.ТекстовыйОтвет));

КонецПроцедуры

Процедура ЗаполнитьВариантИзJSON(
	Документ,
	ВариантJSON,
	ИдентификаторОтвета,
	Вопрос)

	ИдентификаторВарианта =
		ПолучитьUUIDJSON(ВариантJSON, "optionVersionId");
	Вариант = НайтиВариантПоИдентификаторуВерсии(ИдентификаторВарианта);

	Если Не ЗначениеЗаполнено(Вариант)
		Или Вариант.Владелец <> Вопрос Тогда
		ВызватьИсключение "Вариант ответа не найден в опубликованном вопросе.";
	КонецЕсли;

	СтрокаВарианта = Документ.ВариантыОтветов.Добавить();
	СтрокаВарианта.ИдентификаторОтвета = ИдентификаторОтвета;
	СтрокаВарианта.ВариантОтветаВерсии = Вариант;
	СтрокаВарианта.ИдентификаторВерсииВарианта = ИдентификаторВарианта;
	СтрокаВарианта.ПорядокВПопытке =
		ПолучитьСвойствоJSON(ВариантJSON, "order");
	СтрокаВарианта.ТекстВариантаСнимок = Вариант.ТекстВарианта;
	СтрокаВарианта.Выбран =
		ПолучитьСвойствоJSON(ВариантJSON, "selected");

КонецПроцедуры

Функция ПолучитьИлиСоздатьКандидата(ДанныеКандидата, ИдентификаторКандидата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Кандидаты.Ссылка КАК Кандидат
	|ИЗ
	|	Справочник.КандидатыВнешние КАК Кандидаты
	|ГДЕ
	|	Кандидаты.ИдентификаторКандидата = &ИдентификаторКандидата";
	Запрос.УстановитьПараметр(
		"ИдентификаторКандидата",
		ИдентификаторКандидата);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Кандидат = Выборка.Кандидат.ПолучитьОбъект();
	Иначе
		Кандидат = Справочники.КандидатыВнешние.СоздатьЭлемент();
		Кандидат.ИдентификаторКандидата = ИдентификаторКандидата;
	КонецЕсли;

	Кандидат.ОтображаемоеИмя =
		ПолучитьСвойствоJSON(ДанныеКандидата, "displayName");
	Кандидат.Наименование = Лев(Кандидат.ОтображаемоеИмя, 150);
	Кандидат.Email =
		ПолучитьСвойствоJSON(ДанныеКандидата, "email", Ложь, "");
	Кандидат.Активен = Истина;
	Кандидат.РевизияЭлемент =
		ПолучитьСвойствоJSON(ДанныеКандидата, "revision", Ложь, 0);
	Кандидат.Записать();

	ЗарегистрироватьИдентификаторИнтеграции(
		"candidate",
		ИдентификаторКандидата,
		Кандидат.Ссылка);

	Возврат Кандидат.Ссылка;

КонецФункции

