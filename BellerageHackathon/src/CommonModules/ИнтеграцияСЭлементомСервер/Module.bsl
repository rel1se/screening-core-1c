Функция НайтиСсылкуПоИдентификатору(ИмяСправочника, ИмяРеквизита, Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Данные.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК Данные
		|ГДЕ
		|	Данные.%2 = &Идентификатор",
		ИмяСправочника,
		ИмяРеквизита);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьСвойствоJSON(
	ОбъектJSON,
	ИмяСвойства,
	Обязательное = Истина,
	ЗначениеПоУмолчанию = Неопределено)

	Значение = ЗначениеПоУмолчанию;
	Если Не ОбъектJSON.Свойство(ИмяСвойства, Значение) Тогда
		Если Обязательное Тогда
			ВызватьИсключение СтрШаблон(
				"В JSON отсутствует обязательное свойство '%1'.",
				ИмяСвойства);
		КонецЕсли;
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ПолучитьUUIDJSON(ОбъектJSON, ИмяСвойства)

	Значение = ПолучитьСвойствоJSON(ОбъектJSON, ИмяСвойства);
	Попытка
		Возврат Новый УникальныйИдентификатор(Строка(Значение));
	Исключение
		ВызватьИсключение СтрШаблон(
			"Свойство '%1' должно содержать UUID.",
			ИмяСвойства);
	КонецПопытки;

КонецФункции

Функция ПолучитьДатуJSON(ОбъектJSON, ИмяСвойства)

	Значение = ПолучитьСвойствоJSON(ОбъектJSON, ИмяСвойства);
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Строка(Значение));
	Исключение
		ВызватьИсключение СтрШаблон(
			"Свойство '%1' должно содержать дату ISO 8601.",
			ИмяСвойства);
	КонецПопытки;

КонецФункции

Функция ПолучитьСпособЗавершения(Код)

	Если Код = "candidate" Тогда
		Возврат Перечисления.СпособыЗавершенияПопытки.Кандидатом;
	ИначеЕсли Код = "timeout" Тогда
		Возврат Перечисления.СпособыЗавершенияПопытки.ПоИстеченииВремени;
	ИначеЕсли Код = "system" Тогда
		Возврат Перечисления.СпособыЗавершенияПопытки.Системой;
	КонецЕсли;

	ВызватьИсключение "Неподдерживаемый completionMode.";

КонецФункции

Функция ПолучитьСтатусПроверкиОтвета(Код)

	Если Код = "correct" Тогда
		Возврат Перечисления.СтатусыПроверкиОтвета.Правильный;
	ИначеЕсли Код = "incorrect" Тогда
		Возврат Перечисления.СтатусыПроверкиОтвета.Неправильный;
	ИначеЕсли Код = "manualReview" Тогда
		Возврат Перечисления.СтатусыПроверкиОтвета.ОжидаетРучнойПроверки;
	ИначеЕсли Код = "unchecked" Тогда
		Возврат Перечисления.СтатусыПроверкиОтвета.НеПроверен;
	КонецЕсли;

	ВызватьИсключение "Неподдерживаемый checkStatus.";

КонецФункции

Процедура ЗафиксироватьОшибкуОбработкиВходящего(
	СообщениеОбъект,
	Настройки,
	ТекстОшибки)

	СообщениеОбъект.ТекстОшибки = Лев(ТекстОшибки, 4000);

	Если СообщениеОбъект.КоличествоПопыток >= Настройки.МаксимумПопыток Тогда
		СообщениеОбъект.Статус =
			Перечисления.СтатусыСообщенийОбмена.Карантин;
	Иначе
		СообщениеОбъект.Статус =
			Перечисления.СтатусыСообщенийОбмена.ОжидаетПовтора;
		СообщениеОбъект.ДатаСледующейПопытки =
			ТекущаяДатаСеанса()
			+ Настройки.БазоваяЗадержка
				* СообщениеОбъект.КоличествоПопыток;
	КонецЕсли;

КонецПроцедуры

Функция ВычислитьХэшПолезнойНагрузки(ПолезнаяНагрузка) Экспорт

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(
		Строка(ПолезнаяНагрузка),
		КодировкаТекста.UTF8);

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДвоичныеДанные);

	Возврат Base64Строка(Хеширование.ХешСумма);

КонецФункции

#КонецОбласти
