#Область ПрограммныйИнтерфейс

Функция СоздатьТест(Наименование = "Новый тест") Экспорт
    НачатьТранзакцию();
    Попытка
        Тест = Справочники.Тесты.СоздатьЭлемент();
        Тест.Заполнить(Неопределено);
        Тест.Наименование = Наименование;
        Тест.Записать();
        СоздатьЧерновикВТранзакции(Тест.Ссылка);
        ЗафиксироватьТранзакцию();
        Возврат Тест.Ссылка;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция СоздатьЧерновик(Тест) Экспорт
    НачатьТранзакцию();
    Попытка
        ЗаблокироватьТест(Тест);
        Результат = СоздатьЧерновикВТранзакции(Тест);
        ЗафиксироватьТранзакцию();
        Возврат Результат;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция СкопироватьТест(Источник) Экспорт
    НачатьТранзакцию();
    Попытка
        ЗаблокироватьТест(Источник);
        НовыйТест = Справочники.Тесты.СоздатьЭлемент();
        НовыйТест.Заполнить(Неопределено);
        НовыйТест.Наименование = Лев(Источник.Наименование + " (копия)", 150);
        НовыйТест.Записать();
        ВерсияИсточник = Источник.РабочаяВерсия;
        Если Не ЗначениеЗаполнено(ВерсияИсточник) Тогда
            ВерсияИсточник = Источник.ОпубликованнаяВерсия;
        КонецЕсли;
        СоздатьЧерновикВТранзакции(НовыйТест.Ссылка, ВерсияИсточник, Истина);
        ЗафиксироватьТранзакцию();
        Возврат НовыйТест.Ссылка;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Процедура ЗаблокироватьТест(Тест) Экспорт
    Если Не ЗначениеЗаполнено(Тест) Тогда
        ВызватьИсключение "Не выбран тест.";
    КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("Справочник.Тесты");
    Элемент.УстановитьЗначение("Ссылка", Тест);
    Блокировка.Заблокировать();
КонецПроцедуры

Функция СледующийПорядок(ИмяСправочника, Владелец) Экспорт
    Если ИмяСправочника = "ВопросыВерсийТестов" Тогда
        ПолеПорядка = "ПорядокВВерсии";
    ИначеЕсли ИмяСправочника = "ВариантыОтветовВерсий" Тогда
        ПолеПорядка = "Порядок";
    Иначе
        ВызватьИсключение "Неподдерживаемый справочник.";
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(МАКСИМУМ(" + ПолеПорядка
        + "), 0) + 1 КАК Порядок ИЗ Справочник." + ИмяСправочника
        + " ГДЕ Владелец = &Владелец");
    Запрос.УстановитьПараметр("Владелец", Владелец);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Порядок;
КонецФункции

Функция СписокПодчиненных(ИмяСправочника, Владелец) Экспорт
    Если ИмяСправочника = "ВерсииТестов" Тогда
        Поля = "Ссылка, НомерВерсии, НаименованиеТеста, СтатусВерсии, ДатаПубликации";
        Порядок = "НомерВерсии УБЫВ";
    ИначеЕсли ИмяСправочника = "ВопросыВерсийТестов" Тогда
        Поля = "Ссылка, ПорядокВВерсии, ТекстВопроса, ТипОтвета, МаксимальныйБалл";
        Порядок = "ПорядокВВерсии";
    ИначеЕсли ИмяСправочника = "ВариантыОтветовВерсий" Тогда
        Поля = "Ссылка, Порядок, ТекстВарианта, Правильный";
        Порядок = "Порядок";
    Иначе
        ВызватьИсключение "Неподдерживаемый справочник.";
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ " + Поля + " ИЗ Справочник." + ИмяСправочника
        + " ГДЕ Владелец = &Владелец И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО " + Порядок);
    Запрос.УстановитьПараметр("Владелец", Владелец);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ПовторитьСообщение(СсылкаСообщения) Экспорт
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("Справочник.СообщенияОбмена");
        Элемент.УстановитьЗначение("Ссылка", СсылкаСообщения);
        Блокировка.Заблокировать();
        Объект = СсылкаСообщения.ПолучитьОбъект();
        Если Объект.Статус <> Перечисления.СтатусыСообщенийОбмена.ОжидаетПовтора
            И Объект.Статус <> Перечисления.СтатусыСообщенийОбмена.НеобрабатываемаяОшибка
            И Объект.Статус <> Перечисления.СтатусыСообщенийОбмена.Карантин Тогда
            ВызватьИсключение "Повтор доступен только для сообщения с ошибкой.";
        КонецЕсли;
        Объект.Статус = Перечисления.СтатусыСообщенийОбмена.Новое;
        Объект.КоличествоПопыток = 0;
        Объект.ДатаСледующейПопытки = ТекущаяДатаСеанса();
        Объект.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьОтветВручную(Результат, ИдентификаторОтвета, Принят, Комментарий) Экспорт
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("Документ.РезультатПопытки");
        Элемент.УстановитьЗначение("Ссылка", Результат);
        Блокировка.Заблокировать();
        Документ = Результат.ПолучитьОбъект();
        Ответы = Документ.Ответы.НайтиСтроки(Новый Структура("ИдентификаторОтвета", ИдентификаторОтвета));
        Если Ответы.Количество() <> 1 Тогда ВызватьИсключение "Ответ не найден."; КонецЕсли;
        Ответ = Ответы[0];
        Если Ответ.СтатусПроверки <> Перечисления.СтатусыПроверкиОтвета.ОжидаетРучнойПроверки Тогда
            ВызватьИсключение "Ответ уже проверен или не требует ручной проверки.";
        КонецЕсли;
        Ответ.ОтветПравильный = Принят;
        Ответ.НабраноБаллов = ?(Принят, Ответ.МаксимальныйБалл, 0);
        Ответ.СтатусПроверки = ?(Принят, Перечисления.СтатусыПроверкиОтвета.Правильный,
            Перечисления.СтатусыПроверкиОтвета.Неправильный);
        Ответ.КомментарийПроверки = Комментарий;
        Документ.Записать();
        Итог = РасчетРезультатовТестовСервер.РассчитатьИтогПоОтветам(Документ.Ответы, Документ.ПроходнойБаллСнимок);
        Если Не Итог.ЕстьОжидающиеПроверки Тогда
            РасчетРезультатовТестовСервер.ЗавершитьРучнуюПроверку(Результат);
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

#КонецОбласти

Функция СоздатьЧерновикВТранзакции(Тест, Источник = Неопределено, НовыеЛогическиеID = Ложь)
    ОбъектТеста = Тест.ПолучитьОбъект();
    Если ОбъектТеста.Статус = Перечисления.СтатусыТестов.Архивный Тогда
        ВызватьИсключение "Архивный тест нельзя редактировать. Создайте копию теста.";
    КонецЕсли;
    Если ЗначениеЗаполнено(ОбъектТеста.РабочаяВерсия) Тогда Возврат ОбъектТеста.РабочаяВерсия; КонецЕсли;
    Если Источник = Неопределено Тогда Источник = ОбъектТеста.ОпубликованнаяВерсия; КонецЕсли;
    Версия = Справочники.ВерсииТестов.СоздатьЭлемент();
    Версия.Заполнить(Неопределено);
    Версия.Владелец = Тест;
    Версия.НомерВерсии = 1;
    Версия.НаименованиеТеста = Тест.Наименование;
    Версия.ПроходнойБаллПроцентов = 70;
    Если ЗначениеЗаполнено(Источник) Тогда
        ЗаполнитьЗначенияСвойств(Версия, Источник,
            "ОписаниеТеста,ОграничиватьВремя,ЛимитВремениМинуты,КоличествоПопыток,ПроходнойБаллПроцентов,ПеремешиватьВопросы");
        Если Не НовыеЛогическиеID Тогда
            Версия.НомерВерсии = Источник.НомерВерсии + 1;
            Версия.ПредыдущаяВерсия = Источник;
            Версия.НаименованиеТеста = Источник.НаименованиеТеста;
        КонецЕсли;
    КонецЕсли;
    Версия.Наименование = Лев(Версия.НаименованиеТеста + " / " + Строка(Версия.НомерВерсии), 150);
    Версия.Записать();
    Если ЗначениеЗаполнено(Источник) Тогда
        Вопросы = Справочники.ВопросыВерсийТестов.Выбрать(, Источник);
        Пока Вопросы.Следующий() Цикл
            Если Вопросы.ПометкаУдаления Тогда Продолжить; КонецЕсли;
            Вопрос = Справочники.ВопросыВерсийТестов.СоздатьЭлемент();
            ЗаполнитьЗначенияСвойств(Вопрос, Вопросы,
                "ПорядокВВерсии,ТекстВопроса,ТипОтвета,МаксимальныйБалл,СпособПроверки,ЭталонныйОтвет,УчитыватьРегистр,ОбрезатьПробелыПоКраям,СхлопыватьПовторныеПробелы");
            Вопрос.Владелец = Версия.Ссылка;
            Вопрос.Наименование = Лев(Строка(Вопрос.ТекстВопроса), 150);
            Если Не НовыеЛогическиеID Тогда Вопрос.ИдентификаторВопроса = Вопросы.ИдентификаторВопроса; КонецЕсли;
            Вопрос.Записать();
            Варианты = Справочники.ВариантыОтветовВерсий.Выбрать(, Вопросы.Ссылка);
            Пока Варианты.Следующий() Цикл
                Если Варианты.ПометкаУдаления Тогда Продолжить; КонецЕсли;
                Вариант = Справочники.ВариантыОтветовВерсий.СоздатьЭлемент();
                ЗаполнитьЗначенияСвойств(Вариант, Варианты, "Порядок,ТекстВарианта,Правильный");
                Вариант.Владелец = Вопрос.Ссылка;
                Вариант.Наименование = Лев(Строка(Вариант.ТекстВарианта), 150);
                Если Не НовыеЛогическиеID Тогда Вариант.ИдентификаторВарианта = Варианты.ИдентификаторВарианта; КонецЕсли;
                Вариант.Записать();
            КонецЦикла;
        КонецЦикла;
    КонецЕсли;
    ОбъектТеста.РабочаяВерсия = Версия.Ссылка;
    ОбъектТеста.Записать();
    Возврат Версия.Ссылка;
КонецФункции
