&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ХостAPIЭлемента = Константы.ХостAPIЭлемента.Получить();
    ПортAPIЭлемента = Константы.ПортAPIЭлемента.Получить();
    ИспользоватьHTTPSЭлемента = Константы.ИспользоватьHTTPSЭлемента.Получить();
    БазовыйПутьAPIЭлемента = Константы.БазовыйПутьAPIЭлемента.Получить();
    ПутьПолученияТокенаЭлемента = Константы.ПутьПолученияТокенаЭлемента.Получить();
    ИдентификаторКлиентаЭлемента = Константы.ИдентификаторКлиентаЭлемента.Получить();
    СекретКлиентаЭлемента = Константы.СекретКлиентаЭлемента.Получить();
    ТаймаутHTTPСекунды = Константы.ТаймаутHTTPСекунды.Получить();
    МаксимумПопытокОбмена = Константы.МаксимумПопытокОбмена.Получить();
    БазоваяЗадержкаПовтораСекунды = Константы.БазоваяЗадержкаПовтораСекунды.Получить();
    РазмерПакетаОбмена = Константы.РазмерПакетаОбмена.Получить();
    ИдентификаторУзла1С = Константы.ИдентификаторУзла1С.Получить();
    Если ПортAPIЭлемента = 0 Тогда ПортAPIЭлемента = 443; ИспользоватьHTTPSЭлемента = Истина; КонецЕсли;
    Если ТаймаутHTTPСекунды = 0 Тогда ТаймаутHTTPСекунды = 30; КонецЕсли;
    Если МаксимумПопытокОбмена = 0 Тогда МаксимумПопытокОбмена = 10; КонецЕсли;
    Если БазоваяЗадержкаПовтораСекунды = 0 Тогда БазоваяЗадержкаПовтораСекунды = 60; КонецЕсли;
    Если РазмерПакетаОбмена = 0 Тогда РазмерПакетаОбмена = 100; КонецЕсли;
    Если ПустаяСтрока(СокрЛП(ПутьПолученияТокенаЭлемента)) Тогда ПутьПолученияТокенаЭлемента = "/auth/oidc/token"; КонецЕсли;
    Если Не ЗначениеЗаполнено(ИдентификаторУзла1С) Тогда ИдентификаторУзла1С = Новый УникальныйИдентификатор; КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
    СохранитьНаСервере();
    Сообщить("Настройки подключения и авторизации сохранены.");
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
    Если ПустаяСтрока(СокрЛП(ХостAPIЭлемента)) Или СтрНайти(ХостAPIЭлемента, "/") > 0 Тогда
        ВызватьИсключение "Укажите имя хоста без схемы и пути.";
    КонецЕсли;
    Если ПортAPIЭлемента < 1 Или ПортAPIЭлемента > 65535 Или ПортAPIЭлемента <> Цел(ПортAPIЭлемента) Тогда
        ВызватьИсключение "Порт должен быть целым числом от 1 до 65535.";
    КонецЕсли;
    Если ПустаяСтрока(СокрЛП(ПутьПолученияТокенаЭлемента)) Или Лев(ПутьПолученияТокенаЭлемента, 1) <> "/" Тогда
        ВызватьИсключение "Путь получения токена должен начинаться с символа '/'.";
    КонецЕсли;
    Если ПустаяСтрока(СокрЛП(ИдентификаторКлиентаЭлемента)) <> ПустаяСтрока(СокрЛП(СекретКлиентаЭлемента)) Тогда
        ВызватьИсключение "Заполните одновременно Client-Id и Client-Secret.";
    КонецЕсли;
    Если ТаймаутHTTPСекунды < 1 Или МаксимумПопытокОбмена < 1 Или БазоваяЗадержкаПовтораСекунды < 1 Или РазмерПакетаОбмена < 1 Тогда
        ВызватьИсключение "Таймаут, число повторов, задержка и размер пакета должны быть положительными.";
    КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Константы.ХостAPIЭлемента.Установить(ХостAPIЭлемента);
        Константы.ПортAPIЭлемента.Установить(ПортAPIЭлемента);
        Константы.ИспользоватьHTTPSЭлемента.Установить(ИспользоватьHTTPSЭлемента);
        Константы.БазовыйПутьAPIЭлемента.Установить(БазовыйПутьAPIЭлемента);
        Константы.ПутьПолученияТокенаЭлемента.Установить(ПутьПолученияТокенаЭлемента);
        Константы.ИдентификаторКлиентаЭлемента.Установить(ИдентификаторКлиентаЭлемента);
        Константы.СекретКлиентаЭлемента.Установить(СекретКлиентаЭлемента);
        Константы.ТаймаутHTTPСекунды.Установить(ТаймаутHTTPСекунды);
        Константы.МаксимумПопытокОбмена.Установить(МаксимумПопытокОбмена);
        Константы.БазоваяЗадержкаПовтораСекунды.Установить(БазоваяЗадержкаПовтораСекунды);
        Константы.РазмерПакетаОбмена.Установить(РазмерПакетаОбмена);
        Константы.ИдентификаторУзла1С.Установить(ИдентификаторУзла1С);
        ИнтеграцияСЭлементомСервер.СброситьКэшТокенаДоступаЭлемента();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьАвторизацию(Команда)
    СохранитьНаСервере();
    Результат = ПроверитьАвторизациюНаСервере();
    Сообщить("Авторизация выполнена. Токен действует до " + Формат(Результат.ДействуетДо, "ДФ=dd.MM.yyyy HH:mm:ss"));
КонецПроцедуры

&НаСервере
Функция ПроверитьАвторизациюНаСервере()
    Возврат ИнтеграцияСЭлементомСервер.ПроверитьАвторизациюЭлемента();
КонецФункции

&НаКлиенте
Процедура ОбработатьВходящие(Команда)
    ВходящиеНаСервере();
    Сообщить("Обработка входящих завершена. Результаты доступны в журнале обмена.");
КонецПроцедуры

&НаСервере
Процедура ВходящиеНаСервере()
    ИнтеграцияСЭлементомСервер.ОбработатьОчередьВходящихСообщений();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьИсходящие(Команда)
    СохранитьНаСервере();
    ИсходящиеНаСервере();
    Сообщить("Отправка завершена. Результаты доступны в журнале обмена.");
КонецПроцедуры

&НаСервере
Процедура ИсходящиеНаСервере()
    ИнтеграцияСЭлементомСервер.ОбработатьОчередьИсходящихСообщений();
КонецПроцедуры

&НаКлиенте
Процедура Журнал(Команда)
    ОткрытьФорму("Справочник.СообщенияОбмена.ФормаСписка");
КонецПроцедуры
