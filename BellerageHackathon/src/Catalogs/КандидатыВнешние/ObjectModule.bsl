Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ИдентификаторКандидата) Тогда
		ИдентификаторКандидата = Новый УникальныйИдентификатор;
	КонецЕсли;

	Активен = Истина;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторКандидата) Тогда
		ИдентификаторКандидата = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ОтображаемоеИмя)) Тогда
		ВызватьИсключение "Не заполнено отображаемое имя кандидата.";
	КонецЕсли;

	ДатаПоследнейСинхронизации = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Кандидаты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КандидатыВнешние КАК Кандидаты
	|ГДЕ
	|	Кандидаты.Ссылка <> &Ссылка
	|	И Кандидаты.ИдентификаторКандидата = &ИдентификаторКандидата";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ИдентификаторКандидата", ИдентификаторКандидата);

	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Идентификатор кандидата уже используется.";
	КонецЕсли;

КонецПроцедуры
