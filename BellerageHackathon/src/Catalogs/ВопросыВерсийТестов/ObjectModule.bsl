Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ИдентификаторВопроса) Тогда
		ИдентификаторВопроса = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторВерсииВопроса) Тогда
		ИдентификаторВерсииВопроса = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТипОтвета) Тогда
		ТипОтвета = Перечисления.ТипыОтветов.ОдинПравильныйОтвет;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СпособПроверки) Тогда
		СпособПроверки = Перечисления.СпособыПроверкиОтвета.ТочныйВариант;
	КонецЕсли;

	Если МаксимальныйБалл = 0 Тогда
		МаксимальныйБалл = 1;
	КонецЕсли;

	ОбрезатьПробелыПоКраям = Истина;
	СхлопыватьПовторныеПробелы = Истина;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ПроверитьДоступностьИзмененияВерсии();
    Наименование = Лев(Строка(ТекстВопроса), 150);

	Если Не ЗначениеЗаполнено(ИдентификаторВопроса) Тогда
		ИдентификаторВопроса = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторВерсииВопроса) Тогда
		ИдентификаторВерсииВопроса = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если ПорядокВВерсии < 1 Тогда
		ВызватьИсключение "Порядок вопроса должен быть положительным.";
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Строка(ТекстВопроса))) Тогда
		ВызватьИсключение "Не заполнен текст вопроса.";
	КонецЕсли;

	Если МаксимальныйБалл <= 0 Тогда
		ВызватьИсключение "Максимальный балл должен быть больше нуля.";
	КонецЕсли;

	ПроверитьУникальность();

КонецПроцедуры

Процедура ПередУдалением(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ПроверитьДоступностьИзмененияВерсии();

КонецПроцедуры

Процедура ПроверитьДоступностьИзмененияВерсии()
    Если Не ЭтоНовый() Тогда
        ПрежняяВерсия = Ссылка.Владелец;
        Если ЗначениеЗаполнено(ПрежняяВерсия) И ПрежняяВерсия.СтатусВерсии <> Перечисления.СтатусыВерсийТестов.Черновик Тогда
            ВызватьИсключение "Содержимое опубликованной версии нельзя изменять или переносить.";
        КонецЕсли;
    КонецЕсли;

	Если Не ЗначениеЗаполнено(Владелец) Тогда
		ВызватьИсключение "Вопрос должен принадлежать версии теста.";
	КонецЕсли;

	Если Владелец.СтатусВерсии <> Перечисления.СтатусыВерсийТестов.Черновик Тогда
		ВызватьИсключение "Вопросы опубликованной версии нельзя изменять.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьУникальность()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Вопросы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВопросыВерсийТестов КАК Вопросы
	|ГДЕ
	|	Вопросы.Ссылка <> &Ссылка
	|	И (Вопросы.ИдентификаторВерсииВопроса = &ИдентификаторВерсииВопроса
	|		ИЛИ (Вопросы.Владелец = &Владелец
	|			И Вопросы.ПорядокВВерсии = &ПорядокВВерсии))";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ИдентификаторВерсииВопроса", ИдентификаторВерсииВопроса);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("ПорядокВВерсии", ПорядокВВерсии);

	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Идентификатор версии вопроса или порядок уже используется.";
	КонецЕсли;

КонецПроцедуры
