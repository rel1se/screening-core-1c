Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		ИдентификаторСообщения = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыСообщенийОбмена.Новое;
	КонецЕсли;

	ДатаСоздания = ТекущаяДатаСеанса();
	ДатаСледующейПопытки = ДатаСоздания;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		ИдентификаторСообщения = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Направление)
		Или Не ЗначениеЗаполнено(ТипСообщения)
		Или Не ЗначениеЗаполнено(Статус) Тогда
		ВызватьИсключение "Не заполнены направление, тип или статус сообщения.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторСущности)
		Или ПустаяСтрока(ВерсияКонтракта)
		Или ПустаяСтрока(ХэшПолезнойНагрузки) Тогда
		ВызватьИсключение "Не заполнены идентификатор сущности, версия контракта или хэш.";
	КонецЕсли;

	Если ДатаСоздания = Дата(1, 1, 1) Тогда
		ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;

	Если ДатаСледующейПопытки = Дата(1, 1, 1) Тогда
		ДатаСледующейПопытки = ДатаСоздания;
	КонецЕсли;

	Если ПустаяСтрока(Наименование) Тогда
		Наименование = СтрШаблон("%1, %2", ТипСообщения, ИдентификаторСообщения);
	КонецЕсли;

	ПроверитьУникальность();
	ПроверитьНеизменяемыеПоля();

КонецПроцедуры

Процедура ПроверитьУникальность()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сообщения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СообщенияОбмена КАК Сообщения
	|ГДЕ
	|	Сообщения.Ссылка <> &Ссылка
	|	И Сообщения.ИдентификаторСообщения = &ИдентификаторСообщения";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);

	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Идентификатор сообщения уже используется.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНеизменяемыеПоля()

	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сообщения.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	Сообщения.Направление КАК Направление,
	|	Сообщения.ТипСообщения КАК ТипСообщения,
	|	Сообщения.ИдентификаторКорреляции КАК ИдентификаторКорреляции,
	|	Сообщения.ИдентификаторСущности КАК ИдентификаторСущности,
	|	Сообщения.ВерсияКонтракта КАК ВерсияКонтракта,
	|	Сообщения.ХэшПолезнойНагрузки КАК ХэшПолезнойНагрузки
	|ИЗ
	|	Справочник.СообщенияОбмена КАК Сообщения
	|ГДЕ
	|	Сообщения.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий()
		И (Выборка.ИдентификаторСообщения <> ИдентификаторСообщения
			Или Выборка.Направление <> Направление
			Или Выборка.ТипСообщения <> ТипСообщения
			Или Выборка.ИдентификаторКорреляции <> ИдентификаторКорреляции
			Или Выборка.ИдентификаторСущности <> ИдентификаторСущности
			Или Выборка.ВерсияКонтракта <> ВерсияКонтракта
			Или Выборка.ХэшПолезнойНагрузки <> ХэшПолезнойНагрузки) Тогда
		ВызватьИсключение "Идентичность и полезную нагрузку созданного сообщения менять нельзя.";
	КонецЕсли;

КонецПроцедуры
