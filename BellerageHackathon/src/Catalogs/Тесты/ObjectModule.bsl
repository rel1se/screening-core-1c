Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ИдентификаторТеста) Тогда
		ИдентификаторТеста = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыТестов.Черновик;
	КонецЕсли;

	ДатаСоздания = ТекущаяДатаСеанса();
	ДатаПоследнегоИзменения = ДатаСоздания;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторТеста) Тогда
		ИдентификаторТеста = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыТестов.Черновик;
	КонецЕсли;

	Если ДатаСоздания = Дата(1, 1, 1) Тогда
		ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;
	ДатаПоследнегоИзменения = ТекущаяДатаСеанса();

	Если ЗначениеЗаполнено(РабочаяВерсия)
		И РабочаяВерсия.Владелец <> Ссылка Тогда
		ВызватьИсключение "Рабочая версия принадлежит другому тесту.";
	КонецЕсли;

	Если ЗначениеЗаполнено(ОпубликованнаяВерсия)
		И ОпубликованнаяВерсия.Владелец <> Ссылка Тогда
		ВызватьИсключение "Опубликованная версия принадлежит другому тесту.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Тесты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Тесты КАК Тесты
	|ГДЕ
	|	Тесты.ИдентификаторТеста = &ИдентификаторТеста
	|	И Тесты.Ссылка <> &Ссылка";

	Запрос.УстановитьПараметр("ИдентификаторТеста", ИдентификаторТеста);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Идентификатор теста уже используется.";
	КонецЕсли;

КонецПроцедуры
