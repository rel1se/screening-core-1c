Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ИдентификаторВерсии) Тогда
		ИдентификаторВерсии = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтатусВерсии) Тогда
		СтатусВерсии = Перечисления.СтатусыВерсийТестов.Черновик;
	КонецЕсли;

	Если КоличествоПопыток = 0 Тогда
		КоличествоПопыток = 1;
	КонецЕсли;

	Если ПустаяСтрока(ВерсияСхемыОбмена) Тогда
		ВерсияСхемыОбмена = "1.0";
	КонецЕсли;

	ДатаСоздания = ТекущаяДатаСеанса();
	ДатаИзменения = ДатаСоздания;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Владелец) Тогда
		ВызватьИсключение "Версия должна принадлежать тесту.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторВерсии) Тогда
		ИдентификаторВерсии = Новый УникальныйИдентификатор;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтатусВерсии) Тогда
		СтатусВерсии = Перечисления.СтатусыВерсийТестов.Черновик;
	КонецЕсли;

	Если КоличествоПопыток < 1 Тогда
		ВызватьИсключение "Количество попыток должно быть не меньше одной.";
	КонецЕсли;

	Если ПроходнойБаллПроцентов < 0
		Или ПроходнойБаллПроцентов > 100 Тогда
		ВызватьИсключение "Проходной балл должен быть от 0 до 100.";
	КонецЕсли;

	Если ОграничиватьВремя И ЛимитВремениМинуты < 1 Тогда
		ВызватьИсключение "При ограничении времени лимит должен быть положительным.";
	КонецЕсли;

	Если ДатаСоздания = Дата(1, 1, 1) Тогда
		ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;
	ДатаИзменения = ТекущаяДатаСеанса();

	ПроверитьУникальностьВерсии();

	Если Не ЭтоНовый() Тогда
		СтарыйСтатус = ПолучитьСтарыйСтатус();

		Если СтарыйСтатус = Перечисления.СтатусыВерсийТестов.Опубликована Тогда
			Если СтатусВерсии <> Перечисления.СтатусыВерсийТестов.ЗамененаНовой
				Или ИзмененыНеизменяемыеДанные() Тогда
				ВызватьИсключение "Опубликованную версию нельзя изменять.";
			КонецЕсли;
		ИначеЕсли СтарыйСтатус = Перечисления.СтатусыВерсийТестов.ЗамененаНовой Тогда
			ВызватьИсключение "Замененную версию нельзя изменять.";
		КонецЕсли;
	КонецЕсли;

	Если СтатусВерсии = Перечисления.СтатусыВерсийТестов.Опубликована Тогда
		Если ПустаяСтрока(ХэшСодержимого)
			Или Не ЗначениеЗаполнено(ДокументПубликации)
			Или ДатаПубликации = Дата(1, 1, 1)
			Или МаксимальноеКоличествоБаллов <= 0 Тогда
			ВызватьИсключение "Опубликованная версия должна иметь хэш, дату, документ публикации и максимальный балл.";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПередУдалением(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если СтатусВерсии <> Перечисления.СтатусыВерсийТестов.Черновик Тогда
		Отказ = Истина;
		ВызватьИсключение "Удалять можно только черновую версию теста.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьУникальностьВерсии()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Версии.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВерсииТестов КАК Версии
	|ГДЕ
	|	Версии.Ссылка <> &Ссылка
	|	И (Версии.ИдентификаторВерсии = &ИдентификаторВерсии
	|		ИЛИ (Версии.Владелец = &Владелец
	|			И Версии.НомерВерсии = &НомерВерсии))";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ИдентификаторВерсии", ИдентификаторВерсии);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("НомерВерсии", НомерВерсии);

	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Идентификатор или номер версии уже используется в этом тесте.";
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСтарыйСтатус()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Версии.СтатусВерсии КАК СтатусВерсии
	|ИЗ
	|	Справочник.ВерсииТестов КАК Версии
	|ГДЕ
	|	Версии.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СтатусВерсии;
	КонецЕсли;

	Возврат Перечисления.СтатусыВерсийТестов.Черновик;

КонецФункции

Функция ИзмененыНеизменяемыеДанные()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Версии.Владелец КАК Владелец,
	|	Версии.ИдентификаторВерсии КАК ИдентификаторВерсии,
	|	Версии.НомерВерсии КАК НомерВерсии,
	|	Версии.ПредыдущаяВерсия КАК ПредыдущаяВерсия,
	|	Версии.НаименованиеТеста КАК НаименованиеТеста,
	|	Версии.ОписаниеТеста КАК ОписаниеТеста,
	|	Версии.ОграничиватьВремя КАК ОграничиватьВремя,
	|	Версии.ЛимитВремениМинуты КАК ЛимитВремениМинуты,
	|	Версии.КоличествоПопыток КАК КоличествоПопыток,
	|	Версии.ПроходнойБаллПроцентов КАК ПроходнойБаллПроцентов,
	|	Версии.ПеремешиватьВопросы КАК ПеремешиватьВопросы,
	|	Версии.МаксимальноеКоличествоБаллов КАК МаксимальноеКоличествоБаллов,
	|	Версии.ВерсияСхемыОбмена КАК ВерсияСхемыОбмена,
	|	Версии.ХэшСодержимого КАК ХэшСодержимого,
	|	Версии.ДатаСоздания КАК ДатаСоздания,
	|	Версии.ДатаПубликации КАК ДатаПубликации,
	|	Версии.ДокументПубликации КАК ДокументПубликации
	|ИЗ
	|	Справочник.ВерсииТестов КАК Версии
	|ГДЕ
	|	Версии.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Выборка.Владелец <> Владелец
		Или Выборка.ИдентификаторВерсии <> ИдентификаторВерсии
		Или Выборка.НомерВерсии <> НомерВерсии
		Или Выборка.ПредыдущаяВерсия <> ПредыдущаяВерсия
		Или Выборка.НаименованиеТеста <> НаименованиеТеста
		Или Выборка.ОписаниеТеста <> ОписаниеТеста
		Или Выборка.ОграничиватьВремя <> ОграничиватьВремя
		Или Выборка.ЛимитВремениМинуты <> ЛимитВремениМинуты
		Или Выборка.КоличествоПопыток <> КоличествоПопыток
		Или Выборка.ПроходнойБаллПроцентов <> ПроходнойБаллПроцентов
		Или Выборка.ПеремешиватьВопросы <> ПеремешиватьВопросы
		Или Выборка.МаксимальноеКоличествоБаллов <> МаксимальноеКоличествоБаллов
		Или Выборка.ВерсияСхемыОбмена <> ВерсияСхемыОбмена
		Или Выборка.ХэшСодержимого <> ХэшСодержимого
		Или Выборка.ДатаСоздания <> ДатаСоздания
		Или Выборка.ДатаПубликации <> ДатаПубликации
		Или Выборка.ДокументПубликации <> ДокументПубликации;

КонецФункции
